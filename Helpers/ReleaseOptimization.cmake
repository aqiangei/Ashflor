# Optimise the ECS/accessor-heavy game across translation units in release.
option(ASHFLOR_LTO "Enable link-time optimisation in release builds" ON)
function(ashflor_optimize_release target)
    if(DEBUG OR NOT ASHFLOR_LTO)
        return()
    endif()
    # The authored terrain is shared by client and server. Keep its existing
    # floating-point code generation: cross-file fast-math changes can move a
    # boundary, then change a CCD slide or a generated connecting corridor.
    set_source_files_properties(../Shared/Map.cc ../Shared/MapGen.cc
        PROPERTIES COMPILE_OPTIONS -fno-lto)
    if(EMSCRIPTEN OR WASM_SERVER)
        target_compile_options(${target} PRIVATE -flto)
        target_link_options(${target} PRIVATE -flto)
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        get_filename_component(compiler_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
        find_program(ASHFLOR_LLD NAMES ld.lld lld HINTS "${compiler_dir}")
        if(ASHFLOR_LLD)
            get_filename_component(linker_name "${ASHFLOR_LLD}" NAME)
            set(native_linker "${ASHFLOR_LLD}")
            if(linker_name STREQUAL "lld")
                # Emsdk ships the generic driver; its executable name selects
                # the ELF linker. It must be named ld.lld before clang runs it.
                set(native_linker "${CMAKE_CURRENT_BINARY_DIR}/ld.lld")
                file(CREATE_LINK "${ASHFLOR_LLD}" "${native_linker}" SYMBOLIC RESULT link_result)
                if(NOT link_result STREQUAL "0")
                    message(WARNING "Could not select ELF linker; release LTO disabled: ${link_result}")
                    return()
                endif()
            endif()
            target_compile_options(${target} PRIVATE -flto=thin)
            target_link_options(${target} PRIVATE -flto=thin "-fuse-ld=${native_linker}")
        else()
            message(WARNING "ld.lld unavailable; release LTO disabled")
        endif()
    else()
        include(CheckIPOSupported)
        check_ipo_supported(RESULT ipo_supported OUTPUT ipo_error LANGUAGES CXX)
        if(ipo_supported)
            set_property(TARGET ${target} PROPERTY INTERPROCEDURAL_OPTIMIZATION TRUE)
        else()
            message(WARNING "Release LTO unavailable: ${ipo_error}")
        endif()
    endif()
endfunction()
